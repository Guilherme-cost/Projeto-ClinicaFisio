VITE_API_URL=http://localhost:5089

# Peso do Master (acesso total). Deve ser igual ao PesoAcessoTotal do appsettings da API.
VITE_PESO_MASTER=5

# Peso mínimo para ver cada tela (Operador=1, Supervisor=2, Master=5)
VITE_PESO_AGENDAMENTOS=1
VITE_PESO_FILA_ESPERA=1
VITE_PESO_PACIENTES=1
VITE_PESO_ESTOQUE=1
VITE_PESO_AVISOS=1
VITE_PESO_DOCUMENTOS=2
VITE_PESO_DASHBOARD=2
VITE_PESO_CONFIGURACOES=2

# Fila do dia e horários de trabalho
VITE_PESO_PROFISSIONAL=0
VITE_PESO_FILA_DIA=0
VITE_PESO_VER_TODAS_FILAS=1
VITE_PESO_ENCAIXE=1
VITE_PESO_GERENCIAR_HORARIOS=2
VITE_PESO_AUTORIZAR_EXCECAO=2

VITE_PESO_CHAT=0