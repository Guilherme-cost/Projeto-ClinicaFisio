VITE_PESO_FILA_ESPERA=1
VITE_PESO_PACIENTES=1
VITE_PESO_ESTOQUE=1
VITE_PESO_AVISOS=1
VITE_PESO_DOCUMENTOS=2
VITE_PESO_DASHBOARD=2
VITE_PESO_CONFIGURACOES=2